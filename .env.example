# =============================================================================
# SEO AI Agent Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=SEO AI Agent
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# =============================================================================
# OpenCode Configuration
# =============================================================================
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://api.opencode.com
OPENCODE_TIMEOUT=300
OPENCODE_MAX_RETRIES=3

# =============================================================================
# Git Configuration
# =============================================================================
GIT_DEFAULT_BRANCH=main
GIT_COMMIT_AUTHOR_NAME=SEO AI Agent
GIT_COMMIT_AUTHOR_EMAIL=seo-agent@example.com
GIT_PUSH_CHANGES=true
GIT_CREATE_BRANCH=true
GIT_BRANCH_PREFIX=seo/

# =============================================================================
# Repository Configuration
# =============================================================================
REPO_PATH=/path/to/your/repository
REPO_ANALYSIS_DEPTH=3
REPO_IGNORE_PATTERNS=node_modules,.git,__pycache__,*.pyc,.venv,venv
REPO_MAX_FILE_SIZE=10485760

# =============================================================================
# SEO Configuration
# =============================================================================
SEO_PAGE_LIMIT=10
SEO_OUTPUT_DIRECTORY=seo
SEO_SITEMAP_FILENAME=sitemap.xml
SEO_ROBOTS_FILENAME=robots.txt

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=/var/log/seo-agent/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_MODULE=true
LOG_INCLUDE_FUNCTION=true
LOG_INCLUDE_LINE=true

# =============================================================================
# CI/CD Configuration
# =============================================================================
CICD_ENABLED=true
CICD_PROVIDER=github-actions
CICD_TRIGGER_ON_COMMIT=true
CICD_WAIT_FOR_COMPLETION=false
CICD_TIMEOUT=600

# GitHub Actions
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repository
GITHUB_WORKFLOW_ID=deploy.yml

# GitLab CI
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_PROJECT_ID=12345
GITLAB_PIPELINE_ID=

# Azure DevOps
AZURE_DEVOPS_TOKEN=your_azure_token_here
AZURE_ORGANIZATION=your_org
AZURE_PROJECT=your_project
AZURE_PIPELINE_ID=12345

# Jenkins
JENKINS_URL=https://jenkins.example.com
JENKINS_USER=your_username
JENKINS_TOKEN=your_jenkins_token
JENKINS_JOB_NAME=seo-deploy

# =============================================================================
# n8n Webhook Configuration
# =============================================================================
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here
N8N_TIMEOUT=60

# =============================================================================
# Framework Detection
# =============================================================================
FRAMEWORK_DETECTION_ENABLED=true
FRAMEWORK_CACHE_ENABLED=true
FRAMEWORK_CACHE_TTL=3600

# =============================================================================
# Review Configuration
# =============================================================================
REVIEW_MAX_RETRIES=3
REVIEW_APPROVE_THRESHOLD=0.8
REVIEW_STRICT_MODE=false

# =============================================================================
# Testing Configuration
# =============================================================================
TEST_REPO_PATH=/path/to/test/repository
TEST_MOCK_GIT=false
TEST_MOCK_OPENCODE=false
TEST_VERBOSE=false

# =============================================================================
# Security
# =============================================================================
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# Health Check
# =============================================================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5